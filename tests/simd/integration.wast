;; Integration across vector signatures, locals, globals, structured control,
;; direct/indirect calls, and imported global storage.
(module $owner
  (memory (export "memory") 1)
  (func (export "read-memory") (result v128) (v128.load (i32.const 3)))
  (type $identity (func (param v128) (result v128)))
  (global (export "constant") v128 (v128.const i32x4 1 2 3 4))
  (global $state (export "state") (mut v128) (v128.const i32x4 10 20 30 40))
  (table 1 funcref)
  (elem (i32.const 0) $id)
  (func $id (type $identity) (param v128) (result v128) (local.get 0))
  (func (export "direct") (param v128) (result v128) (call $id (local.get 0)))
  (func (export "indirect") (param v128) (result v128)
    (call_indirect (type $identity) (local.get 0) (i32.const 0)))
  (func (export "zero") (result v128) (local v128) (local.get 0))
  (func (export "branch") (param i32) (result v128)
    (block (result v128)
      (br_if 0 (v128.const i32x4 5 6 7 8) (local.get 0))
      (drop)
      (global.get $state)))
  (func (export "return") (result v128)
    (return (v128.const i32x4 -1 -2 -3 -4)))
  (func (export "unreachable") (result v128) (unreachable))
)
(assert_return (invoke "direct" (v128.const i32x4 1 -1 2 -2)) (v128.const i32x4 1 -1 2 -2))
(assert_return (invoke "indirect" (v128.const f64x2 -0 1.25)) (v128.const f64x2 -0 1.25))
(assert_return (invoke "zero") (v128.const i64x2 0 0))
(assert_return (invoke "branch" (i32.const 0)) (v128.const i32x4 10 20 30 40))
(assert_return (invoke "branch" (i32.const 1)) (v128.const i32x4 5 6 7 8))
(assert_return (invoke "return") (v128.const i32x4 -1 -2 -3 -4))
(assert_trap (invoke "unreachable") "unreachable")
(assert_return (get "constant") (v128.const i32x4 1 2 3 4))
(register "vectors")
(module
  (import "vectors" "memory" (memory 1))
  (import "vectors" "constant" (global $constant v128))
  (import "vectors" "state" (global $state (mut v128)))
  (func (export "write-memory") (param v128)
    (v128.store (i32.const 3) (local.get 0)))
  (func (export "constant") (result v128) (global.get $constant))
  (func (export "set") (param v128) (global.set $state (local.get 0)))
  (func (export "get") (result v128) (global.get $state))
  (export "state" (global $state))
)
(assert_return (invoke "constant") (v128.const i32x4 1 2 3 4))
(assert_return (invoke "set" (v128.const i32x4 42 43 44 45)))
(assert_return (invoke "get") (v128.const i32x4 42 43 44 45))
(assert_return (get "state") (v128.const i32x4 42 43 44 45))
(assert_return (invoke "write-memory" (v128.const i32x4 91 92 93 94)))
(assert_return (invoke $owner "read-memory") (v128.const i32x4 91 92 93 94))
