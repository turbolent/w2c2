;; Keep inputs as parameters so native conversion instructions execute at runtime.
(module
  (func (export "unsigned-f32") (param f32) (result i32)
    (i32x4.extract_lane 0 (i32x4.trunc_sat_f32x4_u (f32x4.splat (local.get 0)))))
  (func (export "unsigned-f32-vector") (param v128) (result v128)
    (i32x4.trunc_sat_f32x4_u (local.get 0)))
  (func (export "unsigned-f64") (param f64) (result v128)
    (i32x4.trunc_sat_f64x2_u_zero (f64x2.splat (local.get 0))))
)
(assert_return (invoke "unsigned-f32" (f32.const 2147483648)) (i32.const 2147483648))
(assert_return (invoke "unsigned-f32" (f32.const 3000000000)) (i32.const 3000000000))
(assert_return (invoke "unsigned-f32" (f32.const 4294967040)) (i32.const 4294967040))
(assert_return (invoke "unsigned-f32" (f32.const 4294967296)) (i32.const 4294967295))
(assert_return (invoke "unsigned-f32" (f32.const 2147483520)) (i32.const 2147483520))
(assert_return (invoke "unsigned-f32" (f32.const 1.75)) (i32.const 1))
(assert_return (invoke "unsigned-f32" (f32.const 0.75)) (i32.const 0))
(assert_return (invoke "unsigned-f32" (f32.const -1.75)) (i32.const 0))
(assert_return (invoke "unsigned-f32" (f32.const -0)) (i32.const 0))
(assert_return (invoke "unsigned-f32" (f32.const inf)) (i32.const 4294967295))
(assert_return (invoke "unsigned-f32" (f32.const -inf)) (i32.const 0))
(assert_return (invoke "unsigned-f32" (f32.const nan)) (i32.const 0))
(assert_return (invoke "unsigned-f32" (f32.const -nan:0x12345)) (i32.const 0))
(assert_return (invoke "unsigned-f32-vector" (v128.const f32x4 2147483520 2147483648 3000000000 4294967040))
  (v128.const i32x4 2147483520 2147483648 3000000000 4294967040))
(assert_return (invoke "unsigned-f32-vector" (v128.const f32x4 -inf nan 4294967296 1.75))
  (v128.const i32x4 0 0 4294967295 1))
(assert_return (invoke "unsigned-f64" (f64.const 3000000000.75)) (v128.const i32x4 3000000000 3000000000 0 0))
(assert_return (invoke "unsigned-f64" (f64.const 4294967295)) (v128.const i32x4 4294967295 4294967295 0 0))
(assert_return (invoke "unsigned-f64" (f64.const 4294967296)) (v128.const i32x4 4294967295 4294967295 0 0))
(assert_return (invoke "unsigned-f64" (f64.const nan)) (v128.const i32x4 0 0 0 0))
(assert_return (invoke "unsigned-f64" (f64.const inf)) (v128.const i32x4 4294967295 4294967295 0 0))
(assert_return (invoke "unsigned-f64" (f64.const -inf)) (v128.const i32x4 0 0 0 0))
(assert_return (invoke "unsigned-f64" (f64.const -0)) (v128.const i32x4 0 0 0 0))
