;; Unused loads must trap even when the memory has zero pages.
(module
  (memory 0)
  (func (export "i32.load") (drop (i32.load (i32.const 0))))
  (func (export "i64.load") (drop (i64.load (i32.const 0))))
  (func (export "f32.load") (drop (f32.load (i32.const 0))))
  (func (export "f64.load") (drop (f64.load (i32.const 0))))
  (func (export "i32.load8_s") (drop (i32.load8_s (i32.const 0))))
  (func (export "i64.load16_u") (drop (i64.load16_u (i32.const 0)))))

(assert_trap (invoke "i32.load") "out of bounds memory access")
(assert_trap (invoke "i64.load") "out of bounds memory access")
(assert_trap (invoke "f32.load") "out of bounds memory access")
(assert_trap (invoke "f64.load") "out of bounds memory access")
(assert_trap (invoke "i32.load8_s") "out of bounds memory access")
(assert_trap (invoke "i64.load16_u") "out of bounds memory access")

;; Preserve effects before the trap and prevent effects after it.
(module
  (memory 1)
  (global $state (export "state") (mut i32) (i32.const 0))
  (data (i32.const 65532) "ABCD")
  (data $passive "xy")

  (func (export "ordered-load") (param $address i32)
    (global.set $state (i32.const 1))
    (i32.store (i32.const 0) (i32.const 42))
    (drop (i32.load (local.get $address)))
    (i32.store (i32.const 0) (i32.const 99))
    (global.set $state (i32.const 2)))
  (func (export "read") (param $address i32) (result i32)
    (i32.load (local.get $address)))
  (func (export "overwritten-load") (param $address i32) (result i32)
    (local $value i32)
    (local.set $value (i32.load (local.get $address)))
    (local.set $value (i32.const 7))
    (local.get $value))
  (func (export "identical-arms") (param $address i32) (result i32)
    (if (result i32) (i32.load (local.get $address))
      (then (i32.const 7))
      (else (i32.const 7))))
  (func (export "offset-load") (param $address i32)
    (drop (i32.load offset=4294967295 (local.get $address))))
  (func (export "offset-store") (param $address i32)
    (i32.store offset=4294967295 (local.get $address) (i32.const 0)))
  (func (export "partial-store")
    (i32.store (i32.const 65534) (i32.const 0)))
  (func (export "division-first") (param $zero i32)
    (drop (i32.div_u (i32.const 1) (local.get $zero)))
    (drop (i32.load (i32.const 65536))))
  (func (export "memory-first") (param $zero i32)
    (drop (i32.load (i32.const 65536)))
    (drop (i32.div_u (i32.const 1) (local.get $zero))))
  (func (export "fill") (param $destination i32) (param $size i32)
    (memory.fill (local.get $destination) (i32.const 0) (local.get $size)))
  (func (export "copy") (param $destination i32) (param $source i32) (param $size i32)
    (memory.copy (local.get $destination) (local.get $source) (local.get $size)))
  (func (export "init") (param $destination i32) (param $source i32) (param $size i32)
    (memory.init $passive (local.get $destination) (local.get $source) (local.get $size))))

(assert_trap (invoke "ordered-load" (i32.const 65536)) "out of bounds memory access")
(assert_return (get "state") (i32.const 1))
(assert_return (invoke "read" (i32.const 0)) (i32.const 42))
(assert_return (invoke "ordered-load" (i32.const 0)))
(assert_return (get "state") (i32.const 2))
(assert_return (invoke "read" (i32.const 0)) (i32.const 99))
(assert_trap (invoke "overwritten-load" (i32.const 65536)) "out of bounds memory access")
(assert_return (invoke "overwritten-load" (i32.const 0)) (i32.const 7))
(assert_trap (invoke "identical-arms" (i32.const 65536)) "out of bounds memory access")
(assert_return (invoke "identical-arms" (i32.const 0)) (i32.const 7))
(assert_trap (invoke "offset-load" (i32.const 1)) "out of bounds memory access")
(assert_trap (invoke "offset-store" (i32.const 1)) "out of bounds memory access")
(assert_return (invoke "read" (i32.const 0)) (i32.const 99))
(assert_trap (invoke "partial-store") "out of bounds memory access")
(assert_return (invoke "read" (i32.const 65532)) (i32.const 0x44434241))
(assert_trap (invoke "division-first" (i32.const 0)) "integer divide by zero")
(assert_trap (invoke "memory-first" (i32.const 0)) "out of bounds memory access")
(assert_return (invoke "fill" (i32.const 65536) (i32.const 0)))
(assert_trap (invoke "fill" (i32.const 65537) (i32.const 0)) "out of bounds memory access")
(assert_trap (invoke "fill" (i32.const 65534) (i32.const 4)) "out of bounds memory access")
(assert_return (invoke "read" (i32.const 65532)) (i32.const 0x44434241))
(assert_return (invoke "copy" (i32.const 65536) (i32.const 65536) (i32.const 0)))
(assert_trap (invoke "copy" (i32.const 65537) (i32.const 0) (i32.const 0)) "out of bounds memory access")
(assert_trap (invoke "copy" (i32.const 0) (i32.const 65537) (i32.const 0)) "out of bounds memory access")
(assert_trap (invoke "copy" (i32.const 0) (i32.const 65534) (i32.const 4)) "out of bounds memory access")
(assert_return (invoke "read" (i32.const 0)) (i32.const 99))
(assert_return (invoke "init" (i32.const 65536) (i32.const 2) (i32.const 0)))
(assert_trap (invoke "init" (i32.const 65537) (i32.const 0) (i32.const 0)) "out of bounds memory access")
(assert_trap (invoke "init" (i32.const 0) (i32.const 3) (i32.const 0)) "out of bounds memory access")
(assert_trap (invoke "init" (i32.const 0) (i32.const 1) (i32.const 2)) "out of bounds memory access")
(assert_return (invoke "read" (i32.const 0)) (i32.const 99))

;; The separately compiled futex helpers must perform the same checks.
(module
  (memory 0 1 shared)
  (func (export "grow") (result i32) (memory.grow (i32.const 1)))
  (func (export "notify") (param $address i32)
    (drop (memory.atomic.notify (local.get $address) (i32.const 0))))
  (func (export "wait32")
    (drop (memory.atomic.wait32 (i32.const 0) (i32.const 0) (i64.const 0))))
  (func (export "wait64")
    (drop (memory.atomic.wait64 (i32.const 0) (i64.const 0) (i64.const 0)))))

(assert_trap (invoke "notify" (i32.const 0)) "out of bounds memory access")
(assert_trap (invoke "wait32") "out of bounds memory access")
(assert_trap (invoke "wait64") "out of bounds memory access")
(assert_return (invoke "grow") (i32.const 0))
(assert_trap (invoke "notify" (i32.const 1)) "unaligned atomic")
