;; Local regressions supplementing the upstream cases in global/data/elem.wast.

(module
  (global (export "i32-add") i32 (i32.add (i32.const -1) (i32.const 2)))
  (global (export "i32-sub") i32 (i32.sub (i32.const 0) (i32.const 1)))
  (global (export "i32-mul") i32 (i32.mul (i32.const 0x80000001) (i32.const 2)))
  (global (export "i64-add") i64 (i64.add (i64.const -1) (i64.const 2)))
  (global (export "i64-sub") i64 (i64.sub (i64.const 0) (i64.const 1)))
  (global (export "i64-mul") i64 (i64.mul (i64.const 0x8000000000000001) (i64.const 2)))
  (global (export "i32-nested") i32
    (i32.sub (i32.const 100) (i32.mul (i32.const 7) (i32.const 9))))
  (global (export "i64-nested") i64
    (i64.sub (i64.const 100) (i64.mul (i64.const 7) (i64.const 9))))
  (global (export "i32-flat") i32
    i32.const 5 i32.const 2 i32.sub i32.const 3 i32.mul)
  (global (export "i64-flat") i64
    i64.const 5 i64.const 2 i64.sub i64.const 3 i64.mul)
  (global $first i32 (i32.const 2))
  (global $second i32 (i32.add (global.get $first) (i32.const 1)))
  (global $third (export "chain") (mut i32) (i32.mul (global.get $second) (i32.const 2)))
  (global $float f32 (f32.const -0))
  (global (export "float-copy") f32 (global.get $float))
  (global $double f64 (f64.const -1.5))
  (global (export "double-copy") f64 (global.get $double))
)
(assert_return (get "i32-add") (i32.const 1))
(assert_return (get "i32-sub") (i32.const -1))
(assert_return (get "i32-mul") (i32.const 2))
(assert_return (get "i64-add") (i64.const 1))
(assert_return (get "i64-sub") (i64.const -1))
(assert_return (get "i64-mul") (i64.const 2))
(assert_return (get "i32-nested") (i32.const 37))
(assert_return (get "i64-nested") (i64.const 37))
(assert_return (get "i32-flat") (i32.const 9))
(assert_return (get "i64-flat") (i64.const 9))
(assert_return (get "chain") (i32.const 6))
(assert_return (get "float-copy") (f32.const -0))
(assert_return (get "double-copy") (f64.const -1.5))

(module
  (global (export "base") i32 (i32.const 9))
)
(register "extended-const-base")

(module
  (global $base (import "extended-const-base" "base") i32)
  (global $offset i32 (i32.add (global.get $base) (i32.const 1)))
  (global $function funcref (ref.func $f))
  (global $copy funcref (global.get $function))
  (global $null externref (ref.null extern))
  (global $null-copy (export "null-copy") externref (global.get $null))
  (memory 1)
  (data (i32.add (i32.const -1) (i32.const 2)) "U")
  (data (global.get $offset) "OK")
  (table 32 funcref)
  (elem (i32.mul (i32.const 0x80000001) (i32.const 2)) $f)
  (elem (i32.add (global.get $offset) (i32.const 1)) funcref (global.get $copy))
  (elem $passive funcref (global.get $copy))
  (func $f (result i32) (i32.const 42))
  (func (export "call") (param i32) (result i32)
    (call_indirect (result i32) (local.get 0)))
  (func (export "load") (param i32) (result i32)
    (i32.load8_u (local.get 0)))
  (func (export "init")
    (table.init $passive (i32.const 14) (i32.const 0) (i32.const 1)))
)
(assert_return (invoke "load" (i32.const 1)) (i32.const 85))
(assert_return (invoke "load" (i32.const 10)) (i32.const 79))
(assert_return (invoke "load" (i32.const 11)) (i32.const 75))
(assert_return (invoke "call" (i32.const 2)) (i32.const 42))
(assert_return (invoke "call" (i32.const 11)) (i32.const 42))
(assert_trap (invoke "call" (i32.const 0)) "uninitialized element")
(invoke "init")
(assert_return (invoke "call" (i32.const 14)) (i32.const 42))
(assert_return (get "null-copy") (ref.null extern))
