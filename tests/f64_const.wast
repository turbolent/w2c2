;; Reinterpret constants as integers to check every bit,
;; including NaN signs and payloads.
(module
  (global $nan f64 (f64.const nan))
  (global $negative_nan f64 (f64.const -nan))
  (global $inf f64 (f64.const inf))
  (global $negative_inf f64 (f64.const -inf))

  (func (export "nan") (result i64)
    (i64.reinterpret_f64 (f64.const nan)))
  (func (export "negative_nan") (result i64)
    (i64.reinterpret_f64 (f64.const -nan)))
  (func (export "high_payload") (result i64)
    (i64.reinterpret_f64 (f64.const nan:0x8000080000000)))
  (func (export "negative_high_payload") (result i64)
    (i64.reinterpret_f64 (f64.const -nan:0x8000080000000)))
  (func (export "bit23_payload") (result i64)
    (i64.reinterpret_f64 (f64.const nan:0x800000)))
  (func (export "negative_bit23_payload") (result i64)
    (i64.reinterpret_f64 (f64.const -nan:0x800000)))
  (func (export "low_payload") (result i64)
    (i64.reinterpret_f64 (f64.const nan:0x1)))
  (func (export "negative_low_payload") (result i64)
    (i64.reinterpret_f64 (f64.const -nan:0x1)))
  (func (export "inf") (result i64)
    (i64.reinterpret_f64 (f64.const inf)))
  (func (export "negative_inf") (result i64)
    (i64.reinterpret_f64 (f64.const -inf)))

  (func (export "global_nan") (result i64)
    (i64.reinterpret_f64 (global.get $nan)))
  (func (export "global_negative_nan") (result i64)
    (i64.reinterpret_f64 (global.get $negative_nan)))
  (func (export "global_inf") (result i64)
    (i64.reinterpret_f64 (global.get $inf)))
  (func (export "global_negative_inf") (result i64)
    (i64.reinterpret_f64 (global.get $negative_inf)))
)

(assert_return (invoke "nan") (i64.const 0x7ff8000000000000))
(assert_return (invoke "negative_nan") (i64.const 0xfff8000000000000))
(assert_return (invoke "high_payload") (i64.const 0x7ff8000080000000))
(assert_return (invoke "negative_high_payload") (i64.const 0xfff8000080000000))
(assert_return (invoke "bit23_payload") (i64.const 0x7ff0000000800000))
(assert_return (invoke "negative_bit23_payload") (i64.const 0xfff0000000800000))
(assert_return (invoke "low_payload") (i64.const 0x7ff0000000000001))
(assert_return (invoke "negative_low_payload") (i64.const 0xfff0000000000001))
(assert_return (invoke "inf") (i64.const 0x7ff0000000000000))
(assert_return (invoke "negative_inf") (i64.const 0xfff0000000000000))
(assert_return (invoke "global_nan") (i64.const 0x7ff8000000000000))
(assert_return (invoke "global_negative_nan") (i64.const 0xfff8000000000000))
(assert_return (invoke "global_inf") (i64.const 0x7ff0000000000000))
(assert_return (invoke "global_negative_inf") (i64.const 0xfff0000000000000))
