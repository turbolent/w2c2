;; References preserve their owner and signature through table operations.
(module $owner
  (type $read (func (result i32)))
  (type $relay (func (param funcref) (result funcref)))
  (table 2 funcref)
  (table $t (export "table") 6 8 funcref)
  (global $state (mut i32) (i32.const 42))
  (global (export "ref") funcref (ref.func $read))
  (func $read (result i32) global.get $state)
  (func $other (result i32) i32.const 73)
  (func $wide (result i64) i64.const 99)
  (elem (i32.const 0) func $read)
  (elem (i32.const 1) funcref (ref.null func))
  (elem (table $t) (i32.const 0) func $read $other)
  (elem (table $t) (i32.const 2) funcref (ref.null func) (ref.func $wide))
  (elem $indices func $other $read)
  (elem $expressions funcref (ref.null func) (ref.func $read))
  (elem $declared declare func $read)
  (elem $declared-expressions declare funcref (ref.func $other))
  (elem (i32.const 1) func $relay)
  (func $relay (type $relay) local.get 0)
  (func (export "indirect-ref") (result funcref)
    ref.func $read i32.const 1 call_indirect (type $relay))
  (func (export "call") (param i32) (result i32) local.get 0 call_indirect $t (type $read))
  (func (export "get") (param i32) (result funcref) local.get 0 table.get $t)
  (func (export "set") (param i32 funcref) local.get 0 local.get 1 table.set $t)
  (func (export "size") (result i32) table.size $t)
  (func (export "grow") (param i32) (result i32) ref.func $read local.get 0 table.grow $t)
  (func (export "fill") (param i32 i32) local.get 0 ref.func $other local.get 1 table.fill $t)
  (func (export "copy") (param i32 i32 i32) local.get 0 local.get 1 local.get 2 table.copy $t $t)
  (func (export "init") (param i32 i32 i32) local.get 0 local.get 1 local.get 2 table.init $t $indices)
  (func (export "init-expressions") (param i32 i32 i32)
    local.get 0 local.get 1 local.get 2 table.init $t $expressions)
  (func (export "drop") elem.drop $indices)
  (func (export "active") (param i32) i32.const 0 i32.const 0 local.get 0 table.init $t 0)
  (func (export "declared") (param i32) i32.const 0 i32.const 0 local.get 0 table.init $t $declared)
  (func (export "null-local") (result funcref) (local funcref) local.get 0)
  (func (export "trap-ref") (result funcref) unreachable)
  (func $trap-pair (result funcref i32) unreachable)
  (func (export "trap-pair") call $trap-pair drop drop)
  (func (export "select") (param i32) (result funcref)
    ref.func $read ref.null func local.get 0 select (result funcref))
  (func $recursive (export "recursive") (param i32) (result funcref i32)
    local.get 0 i32.eqz
    if (result funcref i32)
      ref.func $read i32.const 0
    else
      local.get 0 i32.const 1 i32.sub call $recursive i32.const 1 i32.add
    end)
  (func (export "branch") (param i32) (result funcref i32 funcref)
    block (result funcref i32 funcref)
      i64.const 999 ref.func $read i32.const 7 ref.null func local.get 0 br_if 0
      drop drop drop drop ref.null func i32.const 8 ref.func $other
    end)
  (func (export "identity") (param i32) (result funcref)
    ref.func $read local.get 0 if (param funcref) (result funcref) end)
  (func (export "branch-table") (param i32) (result funcref i32)
    block (result funcref i32)
      block (result funcref i32)
        f64.const 999 ref.func $read i32.const 11 local.get 0 br_table 0 1 0
      end
      i32.const 1 i32.add
    end)
  (func (export "loop") (result funcref) (local $n i32)
    ref.func $read i32.const 3
    loop $again (param funcref i32) (result funcref)
      i32.const 1 i32.sub local.tee $n local.get $n br_if $again
      drop
    end)
  (func (export "dead") (result funcref)
    ref.func $read return
    table.get $t table.set $t table.size $t table.grow $t table.fill $t
    table.copy $t $t table.init $t $indices elem.drop $indices
    ref.null func ref.func $other ref.is_null select (result funcref))
)
(register "owner" $owner)
(assert_return (invoke "call" (i32.const 0)) (i32.const 42))
(assert_return (invoke "call" (i32.const 1)) (i32.const 73))
(assert_return (invoke "get" (i32.const 2)) (ref.null func))
(assert_trap (invoke "call" (i32.const 2)) "uninitialized element")
(assert_trap (invoke "call" (i32.const 3)) "indirect call type mismatch")
(assert_trap (invoke "get" (i32.const 6)) "out of bounds table access")
(assert_trap (invoke "get" (i32.const -1)) "out of bounds table access")
(assert_trap (invoke "set" (i32.const 6) (ref.null func)) "out of bounds table access")
(assert_trap (invoke "set" (i32.const -1) (ref.null func)) "out of bounds table access")
(assert_return (invoke "call" (i32.const 0)) (i32.const 42))
(assert_return (invoke "call" (i32.const 1)) (i32.const 73))
(assert_return (invoke "copy" (i32.const 1) (i32.const 0) (i32.const 4)))
(assert_return (invoke "call" (i32.const 1)) (i32.const 42))
(assert_return (invoke "call" (i32.const 2)) (i32.const 73))
(assert_return (invoke "get" (i32.const 3)) (ref.null func))
(assert_trap (invoke "call" (i32.const 4)) "indirect call type mismatch")
(assert_return (invoke "copy" (i32.const 0) (i32.const 1) (i32.const 4)))
(assert_return (invoke "call" (i32.const 0)) (i32.const 42))
(assert_return (invoke "call" (i32.const 1)) (i32.const 73))
(assert_return (invoke "init" (i32.const 4) (i32.const 0) (i32.const 2)))
(assert_return (invoke "call" (i32.const 4)) (i32.const 73))
(assert_return (invoke "call" (i32.const 5)) (i32.const 42))
(assert_trap (invoke "fill" (i32.const 5) (i32.const 2)) "out of bounds table access")
(assert_return (invoke "call" (i32.const 5)) (i32.const 42))
(assert_trap (invoke "copy" (i32.const 0) (i32.const 5) (i32.const 2)) "out of bounds table access")
(assert_return (invoke "call" (i32.const 0)) (i32.const 42))
(assert_trap (invoke "init" (i32.const 0) (i32.const 1) (i32.const 2)) "out of bounds table access")
(assert_return (invoke "call" (i32.const 0)) (i32.const 42))
(assert_return (invoke "drop"))
(assert_return (invoke "drop"))
(assert_return (invoke "init" (i32.const 6) (i32.const 0) (i32.const 0)))
(assert_trap (invoke "init" (i32.const 0) (i32.const 0) (i32.const 1)) "out of bounds table access")
(assert_trap (invoke "init" (i32.const 0) (i32.const 1) (i32.const 0)) "out of bounds table access")
(assert_trap (invoke "init" (i32.const 7) (i32.const 0) (i32.const 0)) "out of bounds table access")
(assert_return (invoke "active" (i32.const 0)))
(assert_return (invoke "declared" (i32.const 0)))
(assert_trap (invoke "active" (i32.const 1)) "out of bounds table access")
(assert_trap (invoke "declared" (i32.const 1)) "out of bounds table access")
(assert_return (invoke "grow" (i32.const 0)) (i32.const 6))
(assert_return (invoke "grow" (i32.const 2)) (i32.const 6))
(assert_return (invoke "call" (i32.const 7)) (i32.const 42))
(assert_return (invoke "grow" (i32.const 1)) (i32.const -1))
(assert_return (invoke "grow" (i32.const -1)) (i32.const -1))
(assert_return (invoke "size") (i32.const 8))
(assert_return (invoke "init-expressions" (i32.const 6) (i32.const 0) (i32.const 2)))
(assert_return (invoke "get" (i32.const 6)) (ref.null func))
(assert_return (invoke "call" (i32.const 7)) (i32.const 42))
(assert_return (invoke "null-local") (ref.null func))
(assert_trap (invoke "trap-ref") "unreachable")
(assert_trap (invoke "trap-pair") "unreachable")
(assert_return (invoke "select" (i32.const 0)) (ref.null func))
(assert_return (invoke "select" (i32.const 1)) (ref.func))
(assert_return (invoke "recursive" (i32.const 5)) (ref.func) (i32.const 5))
(assert_return (invoke "branch" (i32.const 0)) (ref.null func) (i32.const 8) (ref.func))
(assert_return (invoke "branch" (i32.const 1)) (ref.func) (i32.const 7) (ref.null func))
(assert_return (invoke "identity" (i32.const 0)) (ref.func))
(assert_return (invoke "identity" (i32.const 1)) (ref.func))
(assert_return (invoke "branch-table" (i32.const 0)) (ref.func) (i32.const 12))
(assert_return (invoke "branch-table" (i32.const 1)) (ref.func) (i32.const 11))
(assert_return (invoke "branch-table" (i32.const 2)) (ref.func) (i32.const 12))
(assert_return (invoke "loop") (ref.func))
(assert_return (invoke "indirect-ref") (ref.func))
(assert_return (invoke "dead") (ref.func))

;; Two imports can alias one table.
(module $aliases
  (type $read (func (result i32)))
  (table $a (import "owner" "table") 8 funcref)
  (table $b (import "owner" "table") 8 funcref)
  (export "table" (table $b))
  (global $ref (import "owner" "ref") funcref)
  (func $recursive (import "owner" "recursive") (param i32) (result funcref i32))
  (elem $passive funcref (global.get 0))
  (func (export "copy")
    i32.const 1 i32.const 0 i32.const 2 table.copy $a $b)
  (func (export "call") (param i32) (result i32) local.get 0 call_indirect $b (type $read))
  (func (export "init") i32.const 0 i32.const 0 i32.const 1 table.init $a $passive)
  (func (export "forward") (result funcref i32) i32.const 3 call $recursive)
)
(assert_return (invoke "copy"))
(assert_return (invoke "call" (i32.const 1)) (i32.const 42))
(assert_return (invoke "call" (i32.const 2)) (i32.const 73))
(assert_return (invoke "init"))
(assert_return (invoke "forward") (ref.func) (i32.const 3))
(assert_return (invoke "call" (i32.const 0)) (i32.const 42))

;; Re-exports preserve the original table object.
(register "aliases" $aliases)
(module
  (table (import "aliases" "table") 8 funcref)
  (func (export "clear") i32.const 0 ref.null func table.set))
(invoke "clear")
(assert_return (invoke $owner "get" (i32.const 0)) (ref.null func))

;; A module without tables can produce references for another module.
(module $producer
  (global $value (mut i32) (i32.const 91))
  (func $read (result i32) global.get $value)
  (elem declare func $read)
  (func (export "ref") (result funcref) ref.func $read))
(register "producer" $producer)
(module $consumer
  (func $ref (import "producer" "ref") (result funcref))
  (table 1 funcref)
  (func (export "call") (result i32)
    i32.const 0 call $ref table.set
    i32.const 0 call_indirect (result i32)))
(assert_return (invoke "call") (i32.const 91))

;; Later registrations do not change imports bound to an earlier instance.
(module
  (func $read (result i32) i32.const 92)
  (elem declare func $read)
  (func (export "ref") (result funcref) ref.func $read))
(register "producer")
(assert_return (invoke $consumer "call") (i32.const 91))
(module
  (func $ref (import "producer" "ref") (result funcref))
  (table 1 funcref)
  (func (export "call") (result i32)
    i32.const 0 call $ref table.set
    i32.const 0 call_indirect (result i32)))
(assert_return (invoke "call") (i32.const 92))

;; External references preserve host identity through tables and calls.
(module $extern
  (type $pair (func (param externref) (result externref funcref)))
  (global $host (import "spectest" "global_externref") externref)
  (export "host" (global $host))
  (global $value (mut externref) (ref.null extern))
  (global $calls (mut i32) (i32.const 0))
  (table $functions 1 funcref)
  (table $t (export "table") 6 8 externref)
  (table $source 3 externref)
  (elem (table $functions) (i32.const 0) func $pair)
  (elem $active (table $t) (i32.const 0) externref (ref.null extern) (global.get 0))
  (elem (table $source) (i32.const 0) externref (global.get 0))
  (elem $passive externref (global.get 0) (ref.null extern) (global.get 0))
  (elem $empty externref)
  (elem $declared declare externref (global.get 0))
  (func (export "get") (param i32) (result externref) local.get 0 table.get $t)
  (func (export "set") (param i32 externref) local.get 0 local.get 1 table.set $t)
  (func (export "size") (result i32) table.size $t)
  (func (export "grow") (param externref i32) (result i32) local.get 0 local.get 1 table.grow $t)
  (func (export "fill") (param i32 externref i32) local.get 0 local.get 1 local.get 2 table.fill $t)
  (func (export "copy") (param i32 i32 i32) local.get 0 local.get 1 local.get 2 table.copy $t $t)
  (func (export "copy-source") (param i32 i32 i32) local.get 0 local.get 1 local.get 2 table.copy $t $source)
  (func (export "init") (param i32 i32 i32) local.get 0 local.get 1 local.get 2 table.init $t $passive)
  (func (export "drop") elem.drop $passive)
  (func (export "active") (param i32) i32.const 0 i32.const 0 local.get 0 table.init $t $active)
  (func (export "declared") (param i32) i32.const 0 i32.const 0 local.get 0 table.init $t $declared)
  (func (export "empty") i32.const 6 i32.const 0 i32.const 0 table.init $t $empty)
  (func (export "null-local") (result externref) (local externref) local.get 0)
  (func (export "trap-ref") (result externref) unreachable)
  (func (export "set-global") (param externref) local.get 0 global.set $value)
  (func (export "get-global") (result externref) global.get $value)
  (func (export "is-null") (param externref) (result i32) local.get 0 ref.is_null)
  (func $pair (export "pair") (type $pair)
    global.get $calls i32.const 1 i32.add global.set $calls
    local.get 0 ref.func $pair)
  (func (export "calls") (result i32) global.get $calls)
  (func (export "indirect") (param externref) (result externref funcref)
    local.get 0 i32.const 0 call_indirect $functions (type $pair))
  (func (export "wrong-parameter")
    ref.null func i32.const 0 call_indirect (param funcref) (result externref funcref) drop drop)
  (func (export "wrong-result")
    ref.null extern i32.const 0 call_indirect (param externref) (result externref externref) drop drop)
  (func (export "select") (param externref externref i32) (result externref)
    local.get 0 local.get 1 local.get 2 select (result externref))
  (func $recursive (export "recursive") (param externref i32) (result externref i32)
    local.get 1 i32.eqz
    if (result externref i32)
      local.get 0 i32.const 0 return
    else
      local.get 0 local.get 1 i32.const 1 i32.sub call $recursive i32.const 1 i32.add
    end)
  (func (export "branch") (param externref i32) (result externref i32 externref)
    block (result externref i32 externref)
      i64.const 99 local.get 0 i32.const 7 ref.null extern local.get 1 br_if 0
      drop drop drop drop ref.null extern i32.const 8 local.get 0
    end)
  (func (export "branch-table") (param externref i32) (result externref i32)
    block (result externref i32)
      block (result externref i32)
        f64.const 99 local.get 0 i32.const 11 local.get 1 br_table 0 1 0
      end
      i32.const 1 i32.add
    end)
  (func (export "identity") (param externref i32) (result externref)
    local.get 0 local.get 1 if (param externref) (result externref) end)
  (func (export "block") (param externref) (result externref i32)
    local.get 0 block (param externref) (result externref i32) i32.const 42 end)
  (func (export "if") (param externref i32) (result externref i32)
    local.get 0 local.get 1
    if (param externref) (result externref i32) i32.const 1 else i32.const 2 end)
  (func (export "loop") (param externref) (result externref) (local $n i32)
    local.get 0 i32.const 3
    loop (param externref i32) (result externref)
      i32.const 1 i32.sub local.tee $n local.get $n br_if 0 drop
    end)
  (func (export "function-label") (param externref) (result externref)
    i64.const 99 local.get 0 br 0
    block (result externref) ref.null extern end drop)
  (func (export "dead") call $dead drop drop)
  (func $dead (result externref externref)
    unreachable
    ref.null extern drop ref.is_null drop
    table.get $t drop table.set $t table.grow $t drop table.fill $t
    table.copy $t $source table.init $t $passive elem.drop $empty
    select (result externref) drop
    block (param externref) (result externref) end drop
    loop (param externref) (result externref) br 0 end drop
    if (param externref) (result externref) else end drop))
(register "extern" $extern)
(assert_return (get "host") (ref.extern 0))
(assert_return (invoke "get" (i32.const 0)) (ref.null extern))
(assert_return (invoke "get" (i32.const 1)) (ref.extern 0))
(assert_return (invoke "null-local") (ref.null extern))
(assert_trap (invoke "trap-ref") "unreachable")
(assert_return (invoke "get-global") (ref.null extern))
(assert_return (invoke "set-global" (ref.extern 4294967295)))
(assert_return (invoke "get-global") (ref.extern 4294967295))
(assert_return (invoke "is-null" (ref.extern 0)) (i32.const 0))
(assert_return (invoke "is-null" (ref.null extern)) (i32.const 1))
(assert_return (invoke "pair" (ref.extern 0)) (ref.extern 0) (ref.func))
(assert_return (invoke "calls") (i32.const 1))
(assert_return (invoke "indirect" (ref.extern 1)) (ref.extern 1) (ref.func))
(assert_return (invoke "calls") (i32.const 2))
(assert_trap (invoke "wrong-parameter") "indirect call type mismatch")
(assert_trap (invoke "wrong-result") "indirect call type mismatch")
(assert_return (invoke "select" (ref.extern 0) (ref.extern 1) (i32.const 1)) (ref.extern 0))
(assert_return (invoke "select" (ref.extern 0) (ref.null extern) (i32.const 0)) (ref.null extern))
(assert_return (invoke "recursive" (ref.extern 2) (i32.const 5)) (ref.extern 2) (i32.const 5))
(assert_return (invoke "branch" (ref.extern 3) (i32.const 1)) (ref.extern 3) (i32.const 7) (ref.null extern))
(assert_return (invoke "branch" (ref.extern 3) (i32.const 0)) (ref.null extern) (i32.const 8) (ref.extern 3))
(assert_return (invoke "branch-table" (ref.extern 4) (i32.const 0)) (ref.extern 4) (i32.const 12))
(assert_return (invoke "branch-table" (ref.extern 4) (i32.const 1)) (ref.extern 4) (i32.const 11))
(assert_return (invoke "branch-table" (ref.extern 4) (i32.const 2)) (ref.extern 4) (i32.const 12))
(assert_return (invoke "identity" (ref.extern 5) (i32.const 0)) (ref.extern 5))
(assert_return (invoke "identity" (ref.extern 5) (i32.const 1)) (ref.extern 5))
(assert_return (invoke "block" (ref.extern 5)) (ref.extern 5) (i32.const 42))
(assert_return (invoke "if" (ref.extern 5) (i32.const 0)) (ref.extern 5) (i32.const 2))
(assert_return (invoke "if" (ref.extern 5) (i32.const 1)) (ref.extern 5) (i32.const 1))
(assert_return (invoke "loop" (ref.extern 6)) (ref.extern 6))
(assert_return (invoke "function-label" (ref.extern 7)) (ref.extern 7))
(assert_trap (invoke "dead") "unreachable")

;; Full ranges are checked before writes, including zero-length boundaries.
(assert_return (invoke "set" (i32.const 0) (ref.extern 1)))
(assert_return (invoke "set" (i32.const 1) (ref.extern 2)))
(assert_return (invoke "set" (i32.const 2) (ref.extern 3)))
(assert_return (invoke "copy" (i32.const 1) (i32.const 0) (i32.const 3)))
(assert_return (invoke "get" (i32.const 1)) (ref.extern 1))
(assert_return (invoke "get" (i32.const 2)) (ref.extern 2))
(assert_return (invoke "get" (i32.const 3)) (ref.extern 3))
(assert_return (invoke "copy" (i32.const 0) (i32.const 1) (i32.const 3)))
(assert_return (invoke "get" (i32.const 0)) (ref.extern 1))
(assert_return (invoke "get" (i32.const 1)) (ref.extern 2))
(assert_return (invoke "get" (i32.const 2)) (ref.extern 3))
(assert_return (invoke "copy-source" (i32.const 4) (i32.const 0) (i32.const 2)))
(assert_return (invoke "get" (i32.const 4)) (ref.extern 0))
(assert_return (invoke "get" (i32.const 5)) (ref.null extern))
(assert_trap (invoke "get" (i32.const 6)) "out of bounds table access")
(assert_trap (invoke "get" (i32.const -1)) "out of bounds table access")
(assert_trap (invoke "set" (i32.const 6) (ref.extern 9)) "out of bounds table access")
(assert_trap (invoke "set" (i32.const -1) (ref.extern 9)) "out of bounds table access")
(assert_trap (invoke "fill" (i32.const 5) (ref.extern 9) (i32.const 2)) "out of bounds table access")
(assert_return (invoke "get" (i32.const 5)) (ref.null extern))
(assert_trap (invoke "copy" (i32.const 5) (i32.const 0) (i32.const 2)) "out of bounds table access")
(assert_return (invoke "get" (i32.const 5)) (ref.null extern))
(assert_trap (invoke "copy" (i32.const 0) (i32.const 5) (i32.const 2)) "out of bounds table access")
(assert_return (invoke "get" (i32.const 0)) (ref.extern 1))
(assert_trap (invoke "copy-source" (i32.const 0) (i32.const 2) (i32.const 2)) "out of bounds table access")
(assert_return (invoke "get" (i32.const 0)) (ref.extern 1))
(assert_trap (invoke "init" (i32.const 5) (i32.const 0) (i32.const 2)) "out of bounds table access")
(assert_return (invoke "get" (i32.const 5)) (ref.null extern))
(assert_trap (invoke "init" (i32.const 0) (i32.const 2) (i32.const 2)) "out of bounds table access")
(assert_return (invoke "get" (i32.const 0)) (ref.extern 1))
(assert_return (invoke "copy" (i32.const 6) (i32.const 6) (i32.const 0)))
(assert_return (invoke "init" (i32.const 6) (i32.const 3) (i32.const 0)))
(assert_return (invoke "fill" (i32.const 6) (ref.extern 9) (i32.const 0)))
(assert_return (invoke "empty"))
(assert_trap (invoke "fill" (i32.const 7) (ref.extern 9) (i32.const 0)) "out of bounds table access")
(assert_trap (invoke "copy" (i32.const 7) (i32.const 6) (i32.const 0)) "out of bounds table access")
(assert_trap (invoke "copy" (i32.const 6) (i32.const 7) (i32.const 0)) "out of bounds table access")
(assert_trap (invoke "init" (i32.const 7) (i32.const 3) (i32.const 0)) "out of bounds table access")
(assert_trap (invoke "init" (i32.const 6) (i32.const 4) (i32.const 0)) "out of bounds table access")
(assert_return (invoke "active" (i32.const 0)))
(assert_return (invoke "declared" (i32.const 0)))
(assert_trap (invoke "active" (i32.const 1)) "out of bounds table access")
(assert_trap (invoke "declared" (i32.const 1)) "out of bounds table access")
(assert_return (invoke "init" (i32.const 1) (i32.const 0) (i32.const 3)))
(assert_return (invoke "init" (i32.const 3) (i32.const 0) (i32.const 3)))
(assert_return (invoke "get" (i32.const 1)) (ref.extern 0))
(assert_return (invoke "get" (i32.const 2)) (ref.null extern))
(assert_return (invoke "get" (i32.const 3)) (ref.extern 0))
(assert_return (invoke "get" (i32.const 4)) (ref.null extern))
(assert_return (invoke "get" (i32.const 5)) (ref.extern 0))
(assert_return (invoke "drop"))
(assert_return (invoke "drop"))
(assert_return (invoke "init" (i32.const 6) (i32.const 0) (i32.const 0)))
(assert_trap (invoke "init" (i32.const 6) (i32.const 1) (i32.const 0)) "out of bounds table access")
(assert_trap (invoke "init" (i32.const 0) (i32.const 0) (i32.const 1)) "out of bounds table access")
(assert_return (invoke "get" (i32.const 0)) (ref.extern 1))
(assert_return (invoke "grow" (ref.extern 10) (i32.const 0)) (i32.const 6))
(assert_return (invoke "grow" (ref.extern 10) (i32.const 2)) (i32.const 6))
(assert_return (invoke "get" (i32.const 6)) (ref.extern 10))
(assert_return (invoke "get" (i32.const 7)) (ref.extern 10))
(assert_return (invoke "grow" (ref.null extern) (i32.const 1)) (i32.const -1))
(assert_return (invoke "grow" (ref.null extern) (i32.const -1)) (i32.const -1))
(assert_return (invoke "size") (i32.const 8))
(assert_return (invoke "get" (i32.const 7)) (ref.extern 10))
(assert_return (invoke "fill" (i32.const 6) (ref.null extern) (i32.const 2)))
(assert_return (invoke "get" (i32.const 7)) (ref.null extern))

;; Imported tables and globals retain their identity through re-exports.
(module $externalias
  (table $a (import "extern" "table") 6 8 externref)
  (table $b (import "extern" "table") 6 8 externref)
  (global $host (import "extern" "host") externref)
  (func $pair (import "extern" "pair") (param externref) (result externref funcref))
  (export "table" (table $b))
  (global (export "host") externref (global.get $host))
  (elem (table $b) (i32.const 0) externref (global.get 0))
  (func (export "roundtrip") (param externref) (result externref funcref)
    local.get 0 call $pair)
  (func (export "alias") (param externref) (result externref)
    i32.const 1 local.get 0 table.set $a
    i32.const 2 i32.const 1 i32.const 1 table.copy $b $a
    i32.const 2 table.get $b))
(register "externalias")
(assert_return (invoke "roundtrip" (ref.extern 0)) (ref.extern 0) (ref.func))
(assert_return (invoke "alias" (ref.extern 20)) (ref.extern 20))
(assert_return (invoke $extern "get" (i32.const 0)) (ref.extern 0))
(assert_return (invoke $extern "get" (i32.const 2)) (ref.extern 20))
(module
  (table $t (import "externalias" "table") 6 8 externref)
  (global $host (import "externalias" "host") externref)
  (func (export "get") (result externref) i32.const 2 table.get $t)
  (func (export "host") (result externref) global.get $host))
(assert_return (invoke "get") (ref.extern 20))
(assert_return (invoke "host") (ref.extern 0))
