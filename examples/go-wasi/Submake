OBJCOPY ?= objcopy

OBJLIST=$(filter-out gowasi.o,$(patsubst %.c,%.o,$(wildcard *.c))) $(OBJS)

go-wasi: gowasi.o
	$(MAKE) -f Submake $(OBJLIST)
	$(CC) $(CFLAGS) $(OBJLIST) gowasi.o -o go-wasi $(LDFLAGS)

m6_gowasi.data.o: gowasi.c
	ld -r -b binary -o m6_gowasi.data.o m6_gowasi.data
	$(OBJCOPY) --redefine-sym _binary_m6_gowasi_data_start=m6_gowasiData \
		--redefine-sym _binary_m6_gowasi_data_end=m6_gowasiDataEnd \
		--redefine-sym _binary_m6_gowasi_data_size=m6_gowasiDataSize m6_gowasi.data.o

%.o: %.c
	$(CC) -I.. $(CFLAGS) -c $< -o $@
