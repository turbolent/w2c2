OBJCOPY ?= objcopy

OBJLIST:=$(filter-out python.o,$(patsubst %.c,%.o,$(wildcard *.c))) $(OBJS)

python: python.o $(OBJS)
	$(MAKE) -f Submake $(OBJLIST)
	$(CC) $(CFLAGS) $(OBJLIST) python.o -o python $(LDFLAGS)

datasegments.o: python.c
	ld -r -b binary -o datasegments.o datasegments
	$(OBJCOPY) --redefine-sym _binary_datasegments_start=m6_pythonData \
		--redefine-sym _binary_datasegments_end=m6_pythonDataEnd \
		--redefine-sym _binary_datasegments_size=m6_pythonDataSize datasegments.o

%.o: %.c python.c
	$(CC) -I.. $(CFLAGS) -c $< -o $@
