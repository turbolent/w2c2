OBJCOPY ?= objcopy

OBJLIST=$(filter-out llvm.o,$(patsubst %.c,%.o,$(wildcard *.c))) $(OBJS)

sys/bin/llvm: llvm.o
	$(MAKE) -f Submake $(OBJLIST)
	$(CC) $(CFLAGS) $(OBJLIST) llvm.o -o $@ $(LDFLAGS)

m4_llvm.data.o: llvm.c
	ld -r -b binary -o m4_llvm.data.o m4_llvm.data
	$(OBJCOPY) --redefine-sym _binary_m4_llvm_data_start=m4_llvmData \
		--redefine-sym _binary_m4_llvm_data_end=m4_llvmDataEnd \
		--redefine-sym _binary_m4_llvm_data_size=m4_llvmDataSize m4_llvm.data.o

%.o: %.c
	$(CC) -I.. $(CFLAGS) -c $< -o $@
